@using MVC_Basic.Areas.Master.Models
@model List<Item>
<div >
	<div >
		<h1>Item Master</h1>
		<p></p>
	</div>
	<div>
		<div>
			<a asp-area="Master" asp-controller="Item" asp-action="ItemForm">
				<button>Add new Record</button>
			</a>
			<p>Below Table need to use join to display company,group,Unit. We will do that later</p>
		</div>
		<div>
			<table >
				<thead >
					<tr>
						<th></th>
						<th>Name</th>
						<th>Company</th>
						<th>Group</th>
						<th>Unit</th>
						<th>MRP</th>
						<th>Rate</th>
						<th>Barcode</th>
						<th>TaxId</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody >
					@foreach(var item in Model)
					{
						<tr>
							<td>@item.ItemCode</td>
							<td>@item.ItemName</td>
							<td>@item.ItemCompanyCode</td>
							<td>@item.ItemGroupCode</td>
							<td>@item.UnitCode</td>
							<td>@item.MRP</td>
							<td>@item.Rate</td>
							<td>@item.Barcode</td>
							<td>@item.TaxID</td>
							<td>
								<a asp-area="Master" asp-controller="Item" asp-action="ItemForm" asp-route-id="@item.ItemCode">
									<button>Edit</button>
								</a>
								<form asp-area="Master" asp-controller="Item" asp-action="Delete" asp-route-id="@item.ItemCode"
									method="post">
									@Html.AntiForgeryToken()
									<button type="submit"
											onclick="return confirm('Are you sure you want to delete this Item?')">
										Delete
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>