@using MVC_Basic.Areas.Master.Models
@model List<Bank>

<h1>Bank Master</h1>
<hr />
<div >
	<div>
		<button>@Html.ActionLink("Add New Bank", "Insert")</button>
	</div>
	<div >
		<table>
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Address</th>
					<th>IFSC Code</th>
					<th>MICR Code</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach(var rec in Model)
				{
					<tr>
						<td>@rec.BankId</td>
						<td>@rec.Name</td>
						<td>@rec.Address</td>
						<td>@rec.IFSCCode</td>
						<td>@rec.MICRCode</td>
						<td>
							<a asp-area="Master"  asp-controller="Bank"  asp-action="Edit" asp-route-id="@rec.BankId">Edit</a>
							<form asp-area="Master"
								  asp-controller="Bank"
								  asp-action="Delete"
								  asp-route-id="@rec.BankId"
								  method="post"
								  style="display:inline">

								@Html.AntiForgeryToken()

								<button type="submit"
										onclick="return confirm('Are you sure you want to delete this bank?')">
									Delete
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
