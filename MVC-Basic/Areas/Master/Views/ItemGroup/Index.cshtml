@using MVC_Basic.Areas.Master.Models
@model List<ItemGroup>
<div>
	<div >
		<h1>Item Group Master</h1>
	</div>
	<div >
		<div>
			<a asp-area="Master" asp-controller="ItemGroup" asp-action="ItemGroupForm">
				<button>Add New Group</button>
			</a>

		</div>
		<table >
			<thead>
				<tr>
					<th></th>
					<th>Item Group Name</th>
					<th>Discription</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach(var itemgrp in Model)
				{
					<tr>
						<td>@itemgrp.ItemGroupCode</td>
						<td>@itemgrp.ItemGroupName</td>
						<td>@itemgrp.ItemGroupDescription</td>
						<td>
							<a asp-area="Master" asp-controller="ItemGroup" asp-action="ItemGroupForm" asp-route-id="@itemgrp.ItemGroupCode">Edit</a>
							<form asp-area="Master"
								  asp-controller="ItemGroup"
								  asp-action="Delete"
								  asp-route-id="@itemgrp.ItemGroupCode"
								  method="post"
								  style="display:inline">
								@Html.AntiForgeryToken()
								<button type="submit"
										onclick="return confirm('Are you sure you want to delete this bank?')">
									Delete
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>