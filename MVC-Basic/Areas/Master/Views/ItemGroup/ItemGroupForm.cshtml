@model MVC_Basic.Areas.Master.Models.ItemGroup

<h2>@(Model.ItemGroupCode == 0 ? "Add Item Group" : "Edit Item Group")</h2>

<form asp-area="Master"
      asp-controller="ItemGroup"
      asp-action="ItemGroupForm"
      method="post">

    @Html.AntiForgeryToken()

    <!-- REQUIRED FOR EDIT -->
    <input type="hidden" asp-for="ItemGroupCode" />

    <div>
        <label asp-for="ItemGroupName"></label>
        <input asp-for="ItemGroupName" />
    </div>

    <div>
        <label asp-for="ItemGroupDescription"></label>
        <input asp-for="ItemGroupDescription" />
    </div>

    <button type="submit">
        @(Model.ItemGroupCode == 0 ? "Save" : "Update")
    </button>
</form>
