@using MVC_Basic.Areas.Master.Models
@model ItemCompany
<div>
    <div>
        <h1>  Item Group Master</h1>
        <h2>@(Model.CompanyId == 0 ? "Add Item Group" : "Edit Item Group")</h2>

    </div>
    <div>
        <form asp-action="ItemCompanyForm" asp-controller="ItemCompany" asp-area="Master" method="post">
            <!-- REQUIRED FOR EDIT -->
            <input type="hidden" asp-for="CompanyId" />


            <div>
                <label asp-for="CompanyName"></label>
                <input asp-for="CompanyName" />
            </div>

            <div>
                <label asp-for="CompanyDescription"></label>
                <input asp-for="CompanyDescription" />
            </div>

            <button type="submit">
                @(Model.CompanyId == 0 ? "Save" : "Update")
            </button>
        </form>
    </div>
</div>