@using MVC_Basic.Areas.Master.Models
@model List<CustMst>
<div>
	<div>
		<h1>Customer Master</h1>
		<p></p>
	</div>
	<div>
		<div>
			<a asp-area="Master" asp-controller="CustomerMst" asp-action="CombForm">
				<button>Add new Record</button>
			</a>
			<p>Below Table need to use join to display company,group,Unit. We will do that later</p>
		</div>
		<div>
			<table>
				<thead>
					<tr>
						<th></th>
						<th>Name</th>
						<th>Address</th>
						<th>MobileNo.</th>
						<th>PhoneNo.</th>
						<th>Email</th>
						<th>DOB</th>
						<th>AddhareId</th>
						<th>Comm</th>
						<th>Customer</th>
						<th>Dealer</th>
						<th>Supplaier</th>
						<th>Employee</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var Comb in Model)
					{
						<tr>
							<td>@Comb.CombId</td>
							<td>@Comb.CombName</td>
							<td>@Comb.Address</td>
							<td>@Comb.Mobno</td>
							<td>@Comb.Phone</td>
							<td>@Comb.Email</td>
							<td>@Comb.DOB</td>
							<td>@Comb.AddharNo</td>
							<td>@Comb.Comm</td>
							<td>@(Comb.iscust==1? "Yes":"No") </td>
							<td>@(Comb.isDealer==1? "Yes":"No") </td>
							<td>@(Comb.issupplier==1? "Yes":"No") </td>
							<td>@(Comb.isemployee==1? "Yes":"No") </td>
							<td>
								<a asp-area="Master" asp-controller="CustomerMst" asp-action="CombForm" asp-route-id="@Comb.CombId">
									<button>Edit</button>
								</a>
								<form asp-area="Master" asp-controller="CustomerMst" asp-action="Delete" asp-route-id="@Comb.CombId"
									  method="post">
									@Html.AntiForgeryToken()
									<button type="submit"
											onclick="return confirm('Are you sure you want to delete this Comb?')">
										Delete
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>