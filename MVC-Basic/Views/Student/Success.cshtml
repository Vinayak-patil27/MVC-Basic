@{
    ViewBag.Title = "Registration Successful";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto mt-20 bg-white dark:bg-surface-dark p-8 rounded-xl shadow">
    <h1 class="text-3xl font-bold text-green-600 mb-4">
        Registration Successful 🎉
    </h1>

    <p class="text-gray-600 dark:text-gray-300 mb-6">
        Your student registration has been submitted successfully.
    </p>

    <a asp-controller="Student"
       asp-action="Register"
       class="inline-block px-6 py-3 rounded-lg bg-primary text-white font-bold">
        Register Another Student
    </a>
</div>
